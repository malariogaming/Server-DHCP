# Folderul unde CMake va genera fișierele compilate
build/

# Fisiere executabile (dacă sunt generate direct in root)
dhcp_server
*.out
*.exe

# Fisiere obiect (compilare intermediara)
*.o
*.obj

# Configurațiile locale VS Code (opțional, pentru a nu suprascrie setările colegei tale)
.vscode/

# Fisiere de lease generate de serverul tău la runtime (pentru viitor)
*.leases
